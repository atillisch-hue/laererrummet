{
  "name": "laererrummet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:migrations": "node scripts/validate-supabase-migrations.mjs",
    "validate:ops": "node --check scripts/backup-supabase.mjs && node --check scripts/verify-supabase-backup.mjs && node --check scripts/restore-supabase-backup-test.mjs",
    "validate:navigation": "node scripts/validate-navigation.mjs",
    "validate:grammar": "node scripts/validate-grammar-banks.mjs",
    "validate:grammar-retry": "node scripts/validate-grammar-retry.mjs",
    "validate:spelling-exam": "node scripts/validate-fp9-spelling-exam.mjs",
    "validate:reading-exam": "node scripts/validate-reading-exam.mjs",
    "validate:reading-strategies": "node scripts/validate-reading-strategy-training.mjs",
    "validate:math": "node scripts/validate-math-training.mjs",
    "validate:danish": "node scripts/validate-danish-learning.mjs",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "backup:verify": "node scripts/verify-supabase-backup.mjs",
    "restore:test": "node scripts/restore-supabase-backup-test.mjs",
    "build": "npm run validate:migrations && npm run validate:ops && npm run validate:navigation && npm run validate:grammar && npm run validate:grammar-retry && npm run validate:spelling-exam && npm run validate:reading-exam && npm run validate:reading-strategies && npm run validate:math && npm run validate:danish && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  }
}
